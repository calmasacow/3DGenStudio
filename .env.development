# Dev-only frontend config (loaded by `vite`, NOT by `vite build`).
#
# In dev the UI runs on Vite's port (:5173) while the backend runs on :3001, so
# the frontend needs an absolute origin to reach the API.
#
# Do NOT move this into a plain `.env`: that file is loaded for production
# builds too, which would bake an origin into dist/ and break every deployment
# behind a different host, port or reverse proxy. Production builds must stay
# same-origin — see src/config.js.
VITE_SERVER_ORIGIN=http://localhost:3001
